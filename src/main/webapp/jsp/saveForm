<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<html>
<head>
    <title>Добавление водителей</title>
</head>
<body>
<h2>Добавить водителей (из БД: ${count})</h2>

<form action="./saveBatch" method="post">
    <c:forEach begin="0" end="${count - 1}" var="i">
        <fieldset>
            <legend>Водитель #${i + 1}</legend>
            Имя: <input name="first_name_${i}" required><br>
            Фамилия: <input name="last_name_${i}" required><br>
            Возраст: <input type="number" name="age_${i}" min="0" value="0"><br>
            Штрафы: <input type="number" name="fines_num_${i}" min="0" value="0"><br>
            Стаж: <input type="number" name="exp_years_${i}" min="0" value="0"><br>
            Машин: <input type="number" name="cars_num_${i}" min="0" value="0"><br>
        </fieldset><br>
    </c:forEach>
    <button type="submit">Сохранить всех</button>
</form>
</body>
</html>